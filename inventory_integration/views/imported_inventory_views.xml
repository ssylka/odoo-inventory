<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Form view ──────────────────────────────────────────────────── -->
        <record id="view_imported_inventory_form" model="ir.ui.view">
            <field name="name">imported.inventory.form</field>
            <field name="model">inventory.imported_inventory</field>
            <field name="arch" type="xml">
                <form string="Imported Inventory">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="item_count"/>
                            <field name="imported_at"/>
                        </group>
                        <notebook>
                            <page string="Fields">
                                <field name="field_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="field_type"/>
                                        <field name="slot"/>
                                        <field name="total_items"/>
                                        <field name="filled_count"/>
                                        <field name="fill_percent"/>
                                        <field name="num_min"/>
                                        <field name="num_max"/>
                                        <field name="num_avg"/>
                                        <field name="bool_true_count"/>
                                        <field name="bool_false_count"/>
                                        <field name="bool_null_count"/>
                                        <field name="top_values"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ── Tree (list) view ───────────────────────────────────────────── -->
        <record id="view_imported_inventory_tree" model="ir.ui.view">
            <field name="name">imported.inventory.tree</field>
            <field name="model">inventory.imported_inventory</field>
            <field name="arch" type="xml">
                <tree string="Imported Inventories">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="item_count"/>
                    <field name="imported_at"/>
                </tree>
            </field>
        </record>

        <!-- ── Action ─────────────────────────────────────────────────────── -->
        <record id="action_imported_inventory" model="ir.actions.act_window">
            <field name="name">Imported Inventories</field>
            <field name="res_model">inventory.imported_inventory</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ── Menus ──────────────────────────────────────────────────────── -->
        <menuitem id="menu_inventory_integration_root"
                  name="Inventory Integration"
                  sequence="50"/>

        <menuitem id="menu_imported_inventories"
                  name="Imported Inventories"
                  parent="menu_inventory_integration_root"
                  action="action_imported_inventory"
                  sequence="10"/>

        <menuitem id="menu_import_wizard"
                  name="Import from API"
                  parent="menu_inventory_integration_root"
                  action="action_import_inventory_wizard"
                  sequence="20"/>

    </data>
</odoo>
