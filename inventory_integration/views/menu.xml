<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Top-level app menu ─────────────────────────────────────────────── -->
    <menuitem id="menu_inventory_integration_root"
              name="Inventory Integration"
              sequence="90"
              web_icon="inventory_integration,static/description/icon.png"/>

    <!-- ── First sub-menu: list of imported inventories ─────────────────── -->
    <menuitem id="menu_imported_inventories"
              name="Imported Inventories"
              parent="menu_inventory_integration_root"
              action="action_imported_inventory"
              sequence="10"/>

    <!-- ── Second sub-menu: open the import wizard ───────────────────────── -->
    <menuitem id="menu_import_new_inventory"
              name="Import New Inventory"
              parent="menu_inventory_integration_root"
              action="action_import_wizard"
              sequence="20"/>

</odoo>
