<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_import_inventory_wizard_form" model="ir.ui.view">
            <field name="name">inventory.import.wizard.form</field>
            <field name="model">inventory.import_wizard</field>
            <field name="arch" type="xml">
                <form string="Import Inventory from API">
                    <group>
                        <field name="api_url"/>
                        <field name="api_token" password="True"/>
                    </group>
                    <footer>
                        <button name="action_import" type="object"
                                string="Import" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_import_inventory_wizard" model="ir.actions.act_window">
            <field name="name">Import Inventory</field>
            <field name="res_model">inventory.import_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
