<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stand-alone form for a single field (used when drilling into one row) -->
    <record id="view_imported_field_form" model="ir.ui.view">
        <field name="name">inventory.integration.imported_field.form</field>
        <field name="model">inventory.integration.imported_field</field>
        <field name="arch" type="xml">
            <form string="Field Statistics" create="false" edit="false">
                <sheet>
                    <group string="Field Definition">
                        <field name="name" readonly="1"/>
                        <field name="field_type" readonly="1"/>
                        <field name="slot" readonly="1"/>
                        <field name="inventory_id" readonly="1"/>
                    </group>

                    <group string="Fill Rate">
                        <field name="total_items"  readonly="1"/>
                        <field name="filled_count" readonly="1"/>
                        <field name="fill_percent" readonly="1" string="Fill %"/>
                    </group>

                    <group string="Number Statistics"
                           invisible="field_type != 'Number'">
                        <field name="num_min" readonly="1"/>
                        <field name="num_max" readonly="1"/>
                        <field name="num_avg" readonly="1"/>
                    </group>

                    <group string="Text / String Statistics"
                           invisible="field_type not in ('String', 'Text')">
                        <field name="top_values" readonly="1" widget="text"/>
                    </group>

                    <group string="Boolean Statistics"
                           invisible="field_type != 'Bool'">
                        <field name="bool_true_count"  readonly="1"/>
                        <field name="bool_false_count" readonly="1"/>
                        <field name="bool_null_count"  readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
